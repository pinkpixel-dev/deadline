// ACT III: Eli, alive. Going-away party tonight, the archiver after.
// Three ways to reach him: warn him, keep him talking, or let him go.
(
    act: 3,
    dialogues: [
        (
            id: "eli_98_hello",
            with: "eli",
            nodes: [
                (id: "start", branch: [
                    (cond: Flag("eli_told_year"), goto: "dream"),
                    (cond: Flag("talked_eli"), goto: "familiar"),
                ], next: "intro"),
                (id: "dream", lines: [
                    "ok this is gonna sound insane.",
                    "last night i dreamed somebody on node 2 told me it wasn't 1998.",
                    "and now there's somebody on node 2.",
                    "...hi?",
                ], next: "intro"),
                (id: "familiar", lines: [
                    "hey. wait.",
                    "do i know you? you feel familiar. like a song you can't name.",
                ], next: "intro"),
                (id: "intro", lines: [
                    "eli. code board, archiver guy. the sunglasses are canon.",
                    "tonight's my going-away thing at the diner. i'm moving at the end of the month.",
                    "and after the diner i'm running the archiver one last time. all night.",
                    "mara's pulling node 4 after that. so this is goodbye. to it, i mean.",
                ], effects: [Set("eli_plans_run")], choices: [
                    (text: "when did you last sleep?", effects: [Set("knows_eli_awake")], goto: "sleep"),
                    (text: "running it all night? why?", goto: "why"),
                    (text: "how do you run it if mara pulls the plug?", goto: "door"),
                ]),
                (id: "sleep", lines: [
                    "define sleep.",
                    "tuesday? it's friday, right?",
                    "it's fine. i'll sleep when it's done indexing. that's my sig, actually. it's a joke. mostly.",
                ], next: "bye"),
                (id: "why", lines: [
                    "because it's the only one of us that doesn't forget.",
                    "you post something stupid at 3am, it remembers. you stop posting, it remembers that too.",
                    "i just want to say goodbye to it properly. is that weird? that's weird.",
                ], choices: [
                    (text: "it's not weird.", effects: [Add("eli_trust", 1)], goto: "notweird"),
                    (text: "it's a little weird.", goto: "weird"),
                ]),
                (id: "notweird", lines: ["ok good. you're my favorite node 2."], next: "bye"),
                (id: "weird", lines: ["yeah. yeah, kestrel said that too."], next: "bye"),
                (id: "door", lines: [
                    "ok don't tell mara.",
                    "i left myself a back door on every node. {cyan}open 04 --node{/}. it's how i babysit the indexer from home.",
                    "she can pull the plug on the server. she can't pull it on me.",
                ], effects: [Set("knows_door")], next: "bye"),
                (id: "bye", lines: [
                    "anyway! diner's at 10. you should come.",
                    "you won't. node 2 never comes. but you should.",
                ]),
            ],
        ),
        (
            // Repeatable until you warn him, so the choice stays open all evening.
            id: "eli_98_more",
            with: "eli",
            nodes: [
                (id: "start", lines: ["node 2! twice in one night. i'm honored."], choices: [
                    (text: "how do you get into node 4 from home?", cond: NoFlag("knows_door"), goto: "door"),
                    (text: "don't run the archiver tonight.", cond: NoFlag("warned_eli"), goto: "warn"),
                    (text: "go get some sleep before the diner.", goto: "nap"),
                    (text: "just saying hi.", goto: "hi"),
                ]),
                (id: "door", lines: [
                    "ok don't tell mara.",
                    "i left myself a back door on every node. {cyan}open 04 --node{/}. it's how i babysit the indexer from home.",
                ], effects: [Set("knows_door")]),
                (id: "warn", lines: ["huh.", "why not?"], choices: [
                    (text: "you haven't slept in days. you're going to get hurt.", effects: [Set("warned_eli"), Add("truth", 1), Add("eli_trust", 1)], goto: "warned"),
                    (text: "i can't explain. just trust me.", effects: [Set("warned_eli")], goto: "vague"),
                    (text: "never mind.", goto: "end"),
                ]),
                (id: "warned", lines: [
                    "...",
                    "that's a weird thing to say to someone.",
                    "it's also kind of true. ghost said the same thing yesterday. with more swearing.",
                    "ok. maybe i'll sleep after the diner. maybe. no promises.",
                ]),
                (id: "vague", lines: [
                    "that's the most ominous thing anyone's ever said to me on a BBS, and dialtone once threatened to mail me a ferret.",
                    "...ok. i'll think about it.",
                ]),
                (id: "nap", lines: [
                    "sleep is for people who aren't moving across the country.",
                    "but ok. i'll close my eyes for ten minutes. probably.",
                ]),
                (id: "hi", lines: ["hi back. this is nice. nobody on here just says hi."], effects: [Add("eli_trust", 1)]),
                (id: "end", lines: ["ok. back to the indexer."]),
            ],
            on_end: [If(NoFlag("warned_eli"), [Unset("done:eli_98_more"), Unset("chat:eli_98_more")], [])],
            on_leave: [If(NoFlag("warned_eli"), [Unset("left:eli_98_more"), Unset("chat:eli_98_more")], [])],
        ),
        (
            // After the diner. This is the last chance to keep him off node 4.
            id: "eli_98_last",
            with: "eli",
            nodes: [
                (id: "start", branch: [(cond: Flag("warned_eli"), goto: "thought")], next: "back"),
                (id: "back", lines: [
                    "back!! the diner was good. kestrel cried. don't tell kestrel i said that.",
                    "they saved you a seat, by the way. nobody sat in it.",
                ], next: "plan"),
                (id: "thought", lines: [
                    "back from the diner. i thought about what you said.",
                    "they saved you a seat, by the way. nobody sat in it.",
                ], next: "plan"),
                (id: "plan", lines: [
                    "mara says she's too tired to wipe it tonight. she'll do it in the morning.",
                    "so it's me and the indexer. one last run. all night.",
                    "wish me luck?",
                ], choices: [
                    (text: "good luck. say goodbye properly.", effects: [Add("eli_trust", 1)], goto: "go"),
                    (text: "wait. talk to me for a bit first.", goto: "s1"),
                    (text: "eli, please don't. go to sleep.", cond: NoFlag("warned_eli"), effects: [Set("warned_eli"), Add("truth", 1)], goto: "plea"),
                ]),
                (id: "plea", lines: [
                    "you sound like ghost.",
                    "i'll sleep. after. i promise i'll sleep after.",
                ], next: "go"),
                (id: "s1", lines: [
                    "ok, five minutes. the indexer can wait five minutes.",
                    "what's it like on node 2? you never post. you just read.",
                ], choices: [
                    (text: "it's quiet. i like reading all of you.", effects: [Add("eli_trust", 1)], goto: "s2"),
                    (text: "honestly? i don't know how i got here.", effects: [Add("truth", 1)], goto: "s2"),
                    (text: "ok. go run it.", goto: "go"),
                ]),
                (id: "s2", lines: [
                    "same, kind of. i didn't plan to build a thing that remembers everyone. it just kept going.",
                    "...ok. ok i should go. it's waiting.",
                ], choices: [
                    (text: "one more thing. tell me about the comics.", goto: "s3"),
                    (text: "go. it's fine.", goto: "go"),
                ]),
                (id: "s3", lines: [
                    "oh no. you asked about the comics.",
                    "uncanny x-men, 201 through 350. bagged. boarded. i'm selling them and i'm devastated about it.",
                    "ok so issue 227, right, there's this panel",
                ], effects: [Clock("01:12")], choices: [
                    (text: "keep going. i'm listening.", goto: "s4"),
                    (text: "ok. go.", goto: "go"),
                ]),
                (id: "s4", lines: [
                    "...and THAT'S why storm is the best leader the x-men ever had.",
                    "wait.",
                    "it's almost 4am. i've been talking to you for four hours. i didn't even notice.",
                    "that never happens. usually it's the indexer i lose hours to.",
                ], effects: [Clock("03:58")], choices: [
                    (text: "maybe skip the run tonight.", effects: [Set("stalled_eli"), Add("eli_trust", 2)], goto: "stalled"),
                    (text: "ok. now you can go.", goto: "go"),
                ]),
                (id: "stalled", lines: [
                    "yeah.",
                    "yeah, the indexer can wait. mara can have it in the morning.",
                    "i'm gonna sleep. actual sleep. in a bed.",
                    "thanks, node 2. goodnight.",
                    "#*** eli has logged off",
                ], effects: [Set("eli_asleep")]),
                (id: "go", lines: [
                    "ok. here goes.",
                    "#*** node 04: eli session open",
                ], effects: [Set("eli_running")]),
            ],
            on_leave: [If(NoFlag("stalled_eli"), [Set("eli_running")], [])],
        ),
    ],
)
