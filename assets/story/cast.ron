// The cast. Shared by every act; presence and finger change with the story.
(
    users: [
        (
            id: "ghost_17",
            color: "cyan",
            sprite: "ghost_17",
            presence: [
                (cond: All([Flag("y1998"), Any([Flag("at_diner"), Flag("dawn")])]), status: "offline"),
                (cond: Flag("y1998"), status: "online", node: "05"),
                (cond: All([Flag("alt_timeline"), Flag("alt_ghost_gone")]), status: "offline"),
                (cond: All([Flag("act:4"), Lte("trust_ghost", -2)]), status: "away", node: "05"),
                (cond: Flag("act:4"), status: "online", node: "05"),
                (cond: All([Flag("act:2"), Flag("route:cold"), NoFlag("ghost_back")]), status: "offline"),
                (cond: All([Flag("act:2"), Flag("ghost_hiding")]), status: "away", node: "05"),
                (cond: Flag("act:2"), status: "online", node: "05"),
                (cond: Any([Flag("ghost_away"), Flag("actend:1")]), status: "offline"),
                (cond: Always, status: "online", node: "05"),
            ],
            finger: [
                (cond: Flag("y1998"), body: r#"
{b}USER:{/}        ghost_17
{b}LAST LOGIN:{/}  08/14/1998
{b}STATUS:{/}      ONLINE
{b}LOCATION:{/}    node 05
{b}PLAN:{/}
  1. get eli to sleep  2. get kestrel to stop posting about node 2
  3. eat something that isn't from a gas station
"#),
                (cond: All([Flag("alt_timeline"), Flag("alt_ghost_gone")]), body: r#"
{b}USER:{/}        ghost_17
{b}STATUS:{/}      {red}USER DOES NOT EXIST{/}
{b}DELETED:{/}     by ROOT, the first night
"#),
                (cond: All([Flag("act:4"), Any([Flag("told_ghost_model"), Flag("ghost_found_out"), Flag("ghost_found_alone")])]), body: r#"
{b}USER:{/}        ghost_17
{b}LAST LOGIN:{/}  {today}
{b}STATUS:{/}      ONLINE
{b}LOCATION:{/}    node 05 {dim}(mirrored from 04){/}
{b}PLAN:{/}
  find out what the other 11.8% is.
"#),
                (cond: All([Flag("act:2"), Any([NoFlag("route:cold"), Flag("ghost_back")])]), body: r#"
{b}USER:{/}        ghost_17
{b}LAST LOGIN:{/}  {today}
{b}STATUS:{/}      ONLINE
{b}LOCATION:{/}    node 05 {dim}(mirrored from 04){/}
{b}PLAN:{/}
  Nothing deleted stays gone. Including me, apparently.
"#),
                (cond: Flag("actend:1"), body: r#"
{b}USER:{/}        ghost_17
{b}STATUS:{/}      {red}USER DOES NOT EXIST{/}
"#),
                (cond: Always, body: r#"
{b}USER:{/}        ghost_17
{b}LAST LOGIN:{/}  08/14/1998
{b}STATUS:{/}      ONLINE
{b}LOCATION:{/}    UNKNOWN
{b}PLAN:{/}
  Nothing deleted stays gone.
"#),
            ],
            chats: [
                (cond: All([Flag("y1998"), Lte("build", 1)]), dialogue: "ghost_98_hello"),
                (cond: All([Flag("y1998"), Gte("build", 3)]), dialogue: "ghost_98_loop"),
                (cond: All([Flag("y1998"), Gte("build", 2)]), dialogue: "ghost_98_again"),
                (cond: All([Flag("y1998"), Flag("back_from_diner")]), dialogue: "ghost_98_after"),
            ],
            idle: [
                (cond: Flag("y1998"), body: "{cyan}ghost_17:{/} can't talk, losing a flame war about star trek. it's important. ping me later?"),
                (cond: Lte("trust_ghost", -2), body: "ghost_17 sees your message. ghost_17 does not answer."),
                (cond: Flag("act:4"), body: "{cyan}ghost_17:{/} here. reading the same three files over and over. ping me if you find something."),
                (cond: Flag("act:2"), body: "{cyan}ghost_17:{/} still here. still reading the archive. tell me if eli says anything weird. weirder."),
                (cond: Always, body: "{cyan}ghost_17:{/} busy. reading. ping me if something weird happens. (more weird.)"),
            ],
            listed: Always,
            last_login: "08/14/1998",
        ),
        (
            id: "ROOT",
            color: "white",
            sprite: "root",
            presence: [(cond: Always, status: "hidden", node: "01")],
            finger: [(cond: Flag("mara_revealed"), body: r#"
{b}USER:{/}        ROOT
{b}ACCESS:{/}      5
{b}STATUS:{/}      {dim}automated maintenance account{/}
{b}PLAN:{/}
