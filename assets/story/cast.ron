                (cond: Flag("confronted_null"), body: "{magenta}null:{/} still here. still the escape hatch. no hard feelings. some hard feelings."),
                (cond: Always, body: "{magenta}null:{/} ¯\\_(ツ)_/¯  nothing to report. go poke something."),
            ],
            listed: Never,
        ),
