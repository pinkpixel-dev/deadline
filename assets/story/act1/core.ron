// DEADLINE: help, overlays and cinematics for Act I. The cast is in cast.ron.
(
    help: [
        (cmd: "boards", desc: "list message boards"),
        (cmd: "open <#>", desc: "enter a board"),
        (cmd: "read <#>  /  n", desc: "read a message / next unread"),
        (cmd: "mail [#]", desc: "your mailbox"),
        (cmd: "journal", desc: "everything you've found out"),
        (cmd: "note <text>", desc: "write in your journal"),
        (cmd: "users", desc: "who's online"),
        (cmd: "finger <user>", desc: "look someone up"),
        (cmd: "whoami", desc: "your account"),
        (cmd: "chat <user>  /  reply", desc: "private channel"),
        (cmd: "leave", desc: "close a channel"),
        (cmd: "files [dir]  /  cd <dir>", desc: "file area"),
        (cmd: "view <file>", desc: "show a file"),
        (cmd: "inspect <file>", desc: "file details"),
        (cmd: "download <file>", desc: "ZMODEM to local storage"),
        (cmd: "trace <user>", desc: "route a user's connection", cond: Flag("knows_trace")),
        (cmd: "scan", desc: "probe the nodes", cond: Flag("knows_trace")),
        (cmd: "recover <file>", desc: "rebuild a damaged file", cond: Flag("cmd:recover")),
        (cmd: "listen", desc: "", cond: Any([Flag("knows_listen"), All([Flag("help_listen_flash"), NoFlag("listen_vanished")])])),
        (cmd: "history", desc: "command history"),
        (cmd: "snapshot [name]", desc: "write a session snapshot"),
        (cmd: "restore [name]", desc: "restore a snapshot"),
        (cmd: "speed <rate>", desc: "slow, normal, fast, instant"),
        (cmd: "clear", desc: "clear the screen"),
        (cmd: "logout", desc: "hang up"),
    ],

    ambient: [
        (text: "node 05: carrier check ok"),
        (text: "line noise detected, retrying"),
        (text: "node 03: idle timeout"),
        (text: "message base packed: 0 bytes reclaimed"),
        (text: "sysop paged (no answer)"),
        (text: "node 07: no carrier, line held open", cond: Flag("read:306")),
        (text: "node 04: disk access", cond: Flag("eli_seen")),
        (text: "node 04: write 0x00A1..0x00A4", cond: Flag("eli_seen")),
        (text: "*** kestrel has logged on", loud: true, cond: Flag("read:605")),
        (text: "node 02: {player} keystroke latency nominal"),
        (text: "nightly maintenance postponed (reason: none given)"),
        (text: "ROOT: integrity scan complete", cond: Flag("done:root_intro")),
    ],

    overlays: [
        (
            id: "root_first",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THIS SESSION IS BEING OBSERVED.{/}",
            hold: 1,
            hold_text: ["ROOT: Not yet."],
            on_close: [Chat("root_intro")],
        ),
        (
            id: "root_took",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THAT FILE WAS NOT YOURS TO TAKE.{/}",
            on_close: [Mail("m_root_notice")],
        ),
        (
            id: "root_09",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THIS BOARD IS NOT PUBLIC.{/}",
            hold: 2,
            hold_text: ["ROOT: Close it.", "ROOT: I said close it."],
            on_close: [Set("board09_gone"), Add("root_alert", 2), Add("doors", 1), Glitch(700), Notice("BOARD 09 CLOSED BY SYSOP")],
        ),
        (
            id: "root_keys",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Guessing is not a strategy.{/}",
        ),
        (
            id: "root_forced",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}FORCED ENTRY LOGGED.{/}\n\nNode 02. {time}.",
            hold: 1,
            hold_text: ["ROOT: I know who taught you that."],
        ),
        (
            id: "root_trace",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Don't.{/}",
        ),
        (
            id: "root_listen",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Eavesdropping is beneath you.{/}",
        ),
        (
            id: "restore_echo",
            title: "SYSTEM",
            style: "janus",
            body: "You've restored this session before.\n\nYou usually choose differently here.",
            hold: 1,
            hold_text: ["(this message is not in the log)"],
        ),
    ],

    sequences: [
        (
            id: "boot",
            steps: [
                Type("{dim}ATZ{/}"),
                Line("{green}OK{/}"),
                Type("{dim}ATDT 1-555-0142{/}"),
                Pause(500),
                Line("{dim}dialing...{/}"),
                Pause(900),
                Line("{dim}ringing...{/}"),
                Pause(900),
                Line("{dim}ringing...{/}"),
                Pause(700),
                Glitch(300),
                Line("{amber}CARRIER DETECTED{/}"),
                Pause(300),
                Line("{green}CONNECT 14400/ARQ/V32BIS{/}"),
                Pause(400),
                Line("{dim}NEGOTIATING...  ANSI DETECTED{/}"),
                Pause(700),
                Clear,
                Sprite("title_room"),
                Line(""),
                Banner("amber", "DEADLINE"),
                Line(""),
                Line("{dim}LAST CALL:{/} 08/14/1998 03:17 AM      {dim}SYSOP:{/} MARA      {dim}NODES:{/} 8"),
                Line(""),
                // Small changes to the room for every ending seen in earlier runs.
                When(Meta("ending:burn"), [Line("{dim}there's a scorch mark on the corner of the monitor. you don't remember it.{/}")]),
                When(Meta("ending:purge"), [Line("{dim}a floppy labeled SOURCE sits next to the drive.{/}")]),
                When(Meta("ending:archive"), [Line("{dim}someone taped a note to the screen: KEEP IT RUNNING.{/}")]),
                When(Meta("ending:escape"), [Line("{dim}the modem lights are blinking. nothing is dialing.{/}")]),
                When(Meta("ending:human"), [Line("{dim}your watch and the screen disagree about the time. good.{/}")]),
                When(Meta("ending:ghost"), [Line("{dim}there's a second mug next to the keyboard.{/}")]),
                When(Meta("ending:root"), [Line("{dim}for a second, the SYSOP line had your name on it.{/}")]),
                When(Meta("ending:eli"), [Line("{dim}a diner receipt is stuck under the keyboard. 08/14/1998. two coffees.{/}")]),
                When(Meta("ending:loop"), [Line("{violet}subject 00473.{/}")]),
                Pause(900),
                TypeAfter("{b}LOGIN:{/} ", "{white}{player}{/}"),
                Line("{dim}(you didn't type that){/}"),
                Pause(500),
                TypeAfter("{b}PASSWORD:{/} ", "********"),
                Pause(500),
                Line("{dim}AUTHENTICATING...{/}"),
                Pause(1100),
                Line(""),
                Line("{b}WELCOME BACK, {PLAYER}.{/}"),
                Pause(2000),
            ],
            on_end: [Set("booted")],
        ),
        (
            id: "reconnect",
            steps: [
                Type("{dim}ATDT 1-555-0142{/}"),
                Pause(700),
                Line("{amber}CARRIER DETECTED{/}"),
                Line("{green}CONNECT 14400/ARQ/V32BIS{/}"),
                Pause(400),
                Clear,
                Sprite("title_room"),
                Line(""),
                Banner("amber", "DEADLINE"),
                Line(""),
                TypeAfter("{b}LOGIN:{/} ", "{white}{player}{/}"),
                Line("{dim}AUTHENTICATING...{/}"),
                Pause(700),
                When(Restores(3), [Line("{violet}welcome back. again.{/}"), Pause(800)]),
                Line("{b}WELCOME BACK, {PLAYER}.{/}"),
                Pause(1200),
            ],
            on_end: [Set("booted"), Set("reconnected"), Print("{dim}session resumed. {/}{dim}type{/} {cyan}help{/} {dim}if you're lost.{/}")],
        ),
        (
            id: "logout",
            steps: [
                Line("{dim}SAVING SESSION...{/}"),
                Pause(500),
                Line("{dim}+++{/}"),
                Pause(500),
                Line("{dim}ATH0{/}"),
                Pause(400),
                Line("{red}NO CARRIER{/}"),
                Pause(500),
                Sprite("crt_off"),
                When(All([Flag("booted"), NoFlag("actend:1")]), [Pause(1200), Line(""), Line("{dim}*** ghost_17: you'll be back.{/}")]),
                Pause(1500),
            ],
        ),
        (
            id: "kick_1",
            steps: [
                Glitch(600),
                Pause(600),
                Clear,
                Sprite("root"),
                Line(""),
                Type("{white}ROOT:{/} That is enough for one night."),
                Pause(1400),
                Type("{white}ROOT:{/} Go to sleep, {player}."),
                Pause(1600),
                Type("{white}ROOT:{/} We will keep your seat warm."),
                Pause(1800),
                Glitch(400),
                Line(""),
                Line("{red}NO CARRIER{/}"),
                Pause(1600),
            ],
            on_end: [Disconnect],
        ),
        (
            id: "act1_end",
            steps: [
                Glitch(900),
                Pause(900),
                Clear,
                Line("{red}CONNECTION LOST{/}"),
                Pause(1200),
                Line("{dim}retrying...{/}"),
                Pause(1100),
                Glitch(500),
                Line("{dim}retrying...{/}"),
                Pause(1300),
                Line("{red}NO CARRIER{/}"),
                Pause(800),
                Sprite("crt_off"),
                Pause(4400),
                Clear,
                Pause(800),
                Banner("text", "ACT I"),
                Line(""),
                Banner("amber", "CONNECTION"),
                Line(""),
                Pause(1200),
                When(All([Gte("trust_ghost", 2), NoFlag("told_root_ghost")]), [Line("{cyan}ghost_17 is still holding the line open.{/}")]),
                When(Flag("told_root_ghost"), [Line("{white}ROOT has your answer on file.{/}")]),
                When(Flag("forced_archive"), [Line("{magenta}something on node 07 is pleased with you.{/}")]),
                When(Flag("talked_eli"), [Line("{amber}a deleted user said hello to you.{/}")]),
                When(All([Lte("trust_ghost", 1), NoFlag("forced_archive"), NoFlag("told_root_ghost"), NoFlag("talked_eli")]), [Line("{dim}nobody is holding the line open.{/}")]),
                Pause(2600),
                Line(""),
                Line("{dim}the board is still up. it always is.{/}"),
                Pause(3500),
            ],
            on_end: [Set("act1_complete"), Print("{dim}...{/}"), Print("{amber}CARRIER RESTORED.{/} {dim}the board is quieter now.{/}")],
        ),
    ],
)
