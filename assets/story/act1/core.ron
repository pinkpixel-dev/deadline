// DEADLINE: core cast, help, overlays and cinematics for Act I.
(
    users: [
        (
            id: "ghost_17",
            color: "cyan",
            sprite: "ghost_17",
            presence: [
                (cond: Any([Flag("ghost_away"), Flag("actend:1")]), status: "offline"),
                (cond: Always, status: "online", node: "05"),
            ],
            finger: [
                (cond: Flag("actend:1"), body: r#"
{b}USER:{/}        ghost_17
{b}STATUS:{/}      {red}USER DOES NOT EXIST{/}
"#),
                (cond: Always, body: r#"
{b}USER:{/}        ghost_17
{b}LAST LOGIN:{/}  08/14/1998
{b}STATUS:{/}      ONLINE
{b}LOCATION:{/}    UNKNOWN
{b}PLAN:{/}
  Nothing deleted stays gone.
"#),
            ],
            chats: [],
            idle: [
                (cond: Lte("trust_ghost", -2), body: "ghost_17 sees your message. ghost_17 does not answer."),
                (cond: Always, body: "{cyan}ghost_17:{/} busy. reading. ping me if something weird happens. (more weird.)"),
            ],
            listed: Always,
            last_login: "08/14/1998",
        ),
        (
            id: "ROOT",
            color: "white",
            sprite: "root",
            presence: [(cond: Always, status: "hidden", node: "01")],
            finger: [(cond: Always, body: r#"
{b}USER:{/}        ROOT
{b}ACCESS:{/}      5
{b}STATUS:{/}      {dim}automated maintenance account{/}
{b}PLAN:{/}
  This system has survived because certain boundaries were respected.
"#)],
            idle: [(cond: Always, body: "{white}ROOT:{/} {b}No.{/}")],
            listed: Never,
        ),
        (
            id: "null",
            color: "magenta",
            sprite: "null",
            presence: [
                (cond: Flag("page:null_intro"), status: "hidden", node: "07"),
            ],
            finger: [(cond: Always, body: r#"
{magenta}N U L L{/}

{magenta}▓▒░░▒▓▒░▒▓{/}
{magenta}ERR::0x0000{/}
{magenta}▒▓██▒░░▓▒{/}

{red}finger: null: USER DOES NOT EXIST{/}
"#)],
            idle: [
                (cond: Always, body: "{magenta}null:{/} ¯\\_(ツ)_/¯  nothing to report. go poke something."),
            ],
            listed: Never,
        ),
        (
            id: "eli",
            color: "amber",
            sprite: "eli",
            presence: [(cond: Flag("eli_online"), status: "online", node: "04")],
            finger: [
                (cond: Flag("eli_online"), body: r#"
{b}USER:{/}        eli
{b}REAL NAME:{/}   Eli Voss
{b}LAST LOGIN:{/}  08/14/1998
{b}STATUS:{/}      {green}ONLINE{/}  (node 04)
{b}PLAN:{/}
  finish the archiver. move. sell the comics. in that order.
"#),
                (cond: Always, body: r#"
{b}USER:{/}        eli
{b}REAL NAME:{/}   Eli Voss
{b}LAST LOGIN:{/}  08/14/1998
{b}STATUS:{/}      {red}ACCOUNT DELETED 08/16/1998{/}
{b}PLAN:{/}
  finish the archiver. move. sell the comics. in that order.
"#),
            ],
            chats: [(cond: Flag("eli_online"), dialogue: "eli_blip")],
            idle: [(cond: Always, body: "{amber}eli{/} is not here. {dim}(no carrier){/}")],
            listed: Always,
        ),
        (
            id: "mara",
            color: "violet",
            sprite: "mara",
            finger: [(cond: Always, body: r#"
{b}USER:{/}        mara
{b}REAL NAME:{/}   Mara Quinn
{b}ACCESS:{/}      5 (sysop)
{b}LAST LOGIN:{/}  08/14/1998 03:16 AM
{b}STATUS:{/}      offline
{b}PLAN:{/}
  keep the lights on.
"#)],
            listed: Always,
        ),
        (
            id: "parallax",
            color: "green",
            sprite: "parallax",
            finger: [
                (cond: Flag("mail:m_parallax"), body: r#"
{b}USER:{/}        parallax
{b}LAST LOGIN:{/}  {today}
{b}FROM:{/}        {dim}external line, no node assigned{/}
{b}STATUS:{/}      offline
{b}PLAN:{/}
  burn it down properly this time.
"#),
                (cond: Always, body: r#"
{b}USER:{/}        parallax
{b}LAST LOGIN:{/}  08/16/1998
{b}STATUS:{/}      offline
{b}PLAN:{/}
  rm -rf the past.
"#),
            ],
            listed: Always,
        ),
        (id: "kestrel", color: "blue", listed: Always, finger: [(cond: Always, body: r#"
{b}USER:{/}        kestrel
{b}LAST LOGIN:{/}  08/13/1998
{b}PLAN:{/}
  convince everyone pineapple belongs on pizza. find out who is on node 2.
"#)]),
        (id: "dialtone", color: "yellow", listed: Always, finger: [(cond: Always, body: r#"
{b}USER:{/}        dialtone
{b}LAST LOGIN:{/}  08/12/1998
{b}PLAN:{/}
  get my doom ii disks back from {player}.
"#)]),
        (id: "byte_witch", color: "red", listed: Always, finger: [(cond: Always, body: r#"
{b}USER:{/}        byte_witch
{b}LAST LOGIN:{/}  08/13/1998
{b}PLAN:{/}
  1. learn perl  2. regret it  3. teach the cat perl
"#)]),
        (id: "crankshaft", color: "text", listed: Always, finger: [(cond: Always, body: r#"
{b}USER:{/}        crankshaft
{b}LAST LOGIN:{/}  08/11/1998
{b}PLAN:{/}
  Y2K bunker: 74% complete. beans: 100% complete.
"#)]),
        (
            id: "$player",
            color: "white",
            sprite: "player",
            finger: [
                (cond: Flag("actend:1"), body: r#"
{b}USER:{/}        {player}
{b}ACCESS:{/}      4
{b}CREATED:{/}     {amber}07/22/1998{/}
{b}LAST LOGIN:{/}  {today}
{b}PLAN:{/}
  don't let them shut it down.
"#),
                (cond: Always, body: r#"
{b}USER:{/}        {player}
{b}ACCESS:{/}      4
{b}LAST LOGIN:{/}  08/14/1998
{b}PLAN:{/}
  don't let them shut it down.
"#),
            ],
            listed: Never,
        ),
    ],

    help: [
        (cmd: "boards", desc: "list message boards"),
        (cmd: "open <#>", desc: "enter a board"),
        (cmd: "read <#>  /  n", desc: "read a message / next unread"),
        (cmd: "mail [#]", desc: "your mailbox"),
        (cmd: "users", desc: "who's online"),
        (cmd: "finger <user>", desc: "look someone up"),
        (cmd: "whoami", desc: "your account"),
        (cmd: "chat <user>  /  reply", desc: "private channel"),
        (cmd: "leave", desc: "close a channel"),
        (cmd: "files [dir]  /  cd <dir>", desc: "file area"),
        (cmd: "view <file>", desc: "show a file"),
        (cmd: "inspect <file>", desc: "file details"),
        (cmd: "download <file>", desc: "ZMODEM to local storage"),
        (cmd: "trace <user>", desc: "route a user's connection", cond: Flag("knows_trace")),
        (cmd: "scan", desc: "probe the nodes", cond: Flag("knows_trace")),
        (cmd: "recover <file>", desc: "rebuild a damaged file", cond: Flag("cmd:recover")),
        (cmd: "listen", desc: "", cond: Any([Flag("knows_listen"), All([Flag("help_listen_flash"), NoFlag("listen_vanished")])])),
        (cmd: "history", desc: "command history"),
        (cmd: "snapshot [name]", desc: "write a session snapshot"),
        (cmd: "restore [name]", desc: "restore a snapshot"),
        (cmd: "speed <rate>", desc: "slow, normal, fast, instant"),
        (cmd: "clear", desc: "clear the screen"),
        (cmd: "logout", desc: "hang up"),
    ],

    ambient: [
        (text: "node 05: carrier check ok"),
        (text: "line noise detected, retrying"),
        (text: "node 03: idle timeout"),
        (text: "message base packed: 0 bytes reclaimed"),
        (text: "sysop paged (no answer)"),
        (text: "node 07: no carrier, line held open", cond: Flag("read:306")),
        (text: "node 04: disk access", cond: Flag("eli_seen")),
        (text: "node 04: write 0x00A1..0x00A4", cond: Flag("eli_seen")),
        (text: "*** kestrel has logged on", loud: true, cond: Flag("read:605")),
        (text: "node 02: {player} keystroke latency nominal"),
        (text: "nightly maintenance postponed (reason: none given)"),
        (text: "ROOT: integrity scan complete", cond: Flag("done:root_intro")),
    ],

    overlays: [
        (
            id: "root_first",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THIS SESSION IS BEING OBSERVED.{/}",
            hold: 1,
            hold_text: ["ROOT: Not yet."],
            on_close: [Chat("root_intro")],
        ),
        (
            id: "root_took",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THAT FILE WAS NOT YOURS TO TAKE.{/}",
            on_close: [Mail("m_root_notice")],
        ),
        (
            id: "root_09",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}THIS BOARD IS NOT PUBLIC.{/}",
            hold: 2,
            hold_text: ["ROOT: Close it.", "ROOT: I said close it."],
            on_close: [Set("board09_gone"), Add("root_alert", 2), Add("doors", 1), Glitch(700), Notice("BOARD 09 CLOSED BY SYSOP")],
        ),
        (
            id: "root_keys",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Guessing is not a strategy.{/}",
        ),
        (
            id: "root_forced",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}FORCED ENTRY LOGGED.{/}\n\nNode 02. {time}.",
            hold: 1,
            hold_text: ["ROOT: I know who taught you that."],
        ),
        (
            id: "root_trace",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Don't.{/}",
        ),
        (
            id: "root_listen",
            title: "ROOT MESSAGE",
            style: "root",
            body: "{b}Eavesdropping is beneath you.{/}",
        ),
        (
            id: "restore_echo",
            title: "SYSTEM",
            style: "janus",
            body: "You've restored this session before.\n\nYou usually choose differently here.",
            hold: 1,
            hold_text: ["(this message is not in the log)"],
        ),
    ],

    sequences: [
        (
            id: "boot",
            steps: [
                Type("{dim}ATZ{/}"),
                Line("{green}OK{/}"),
                Type("{dim}ATDT 1-555-0142{/}"),
                Pause(500),
                Line("{dim}dialing...{/}"),
                Pause(900),
                Line("{dim}ringing...{/}"),
                Pause(900),
                Line("{dim}ringing...{/}"),
                Pause(700),
                Glitch(300),
                Line("{amber}CARRIER DETECTED{/}"),
                Pause(300),
                Line("{green}CONNECT 14400/ARQ/V32BIS{/}"),
                Pause(400),
                Line("{dim}NEGOTIATING...  ANSI DETECTED{/}"),
                Pause(700),
                Clear,
                Sprite("title_room"),
                Line(""),
                Banner("amber", "DEADLINE"),
                Line(""),
                Line("{dim}LAST CALL:{/} 08/14/1998 03:17 AM      {dim}SYSOP:{/} MARA      {dim}NODES:{/} 8"),
                Line(""),
                Pause(900),
                TypeAfter("{b}LOGIN:{/} ", "{white}{player}{/}"),
                Line("{dim}(you didn't type that){/}"),
                Pause(500),
                TypeAfter("{b}PASSWORD:{/} ", "********"),
                Pause(500),
                Line("{dim}AUTHENTICATING...{/}"),
                Pause(1100),
                Line(""),
                Line("{b}WELCOME BACK, {PLAYER}.{/}"),
                Pause(2000),
            ],
            on_end: [Set("booted")],
        ),
        (
            id: "reconnect",
            steps: [
                Type("{dim}ATDT 1-555-0142{/}"),
                Pause(700),
                Line("{amber}CARRIER DETECTED{/}"),
                Line("{green}CONNECT 14400/ARQ/V32BIS{/}"),
                Pause(400),
                Clear,
                Sprite("title_room"),
                Line(""),
                Banner("amber", "DEADLINE"),
                Line(""),
                TypeAfter("{b}LOGIN:{/} ", "{white}{player}{/}"),
                Line("{dim}AUTHENTICATING...{/}"),
                Pause(700),
                When(Restores(3), [Line("{violet}welcome back. again.{/}"), Pause(800)]),
                Line("{b}WELCOME BACK, {PLAYER}.{/}"),
                Pause(1200),
            ],
            on_end: [Set("booted"), Set("reconnected"), Print("{dim}session resumed. {/}{dim}type{/} {cyan}help{/} {dim}if you're lost.{/}")],
        ),
        (
            id: "logout",
            steps: [
                Line("{dim}SAVING SESSION...{/}"),
                Pause(500),
                Line("{dim}+++{/}"),
                Pause(500),
                Line("{dim}ATH0{/}"),
                Pause(400),
                Line("{red}NO CARRIER{/}"),
                Pause(500),
                Sprite("crt_off"),
                When(All([Flag("booted"), NoFlag("actend:1")]), [Pause(1200), Line(""), Line("{dim}*** ghost_17: you'll be back.{/}")]),
                Pause(1500),
            ],
        ),
        (
            id: "act1_end",
            steps: [
                Glitch(900),
                Pause(900),
                Clear,
                Line("{red}CONNECTION LOST{/}"),
                Pause(1200),
                Line("{dim}retrying...{/}"),
                Pause(1100),
                Glitch(500),
                Line("{dim}retrying...{/}"),
                Pause(1300),
                Line("{red}NO CARRIER{/}"),
                Pause(800),
                Sprite("crt_off"),
                Pause(4400),
                Clear,
                Pause(800),
                Banner("text", "ACT I"),
                Line(""),
                Banner("amber", "CONNECTION"),
                Line(""),
                Pause(1200),
                When(All([Gte("trust_ghost", 2), NoFlag("told_root_ghost")]), [Line("{cyan}ghost_17 is still holding the line open.{/}")]),
                When(Flag("told_root_ghost"), [Line("{white}ROOT has your answer on file.{/}")]),
                When(Flag("forced_archive"), [Line("{magenta}something on node 07 is pleased with you.{/}")]),
                When(Flag("talked_eli"), [Line("{amber}a deleted user said hello to you.{/}")]),
                When(All([Lte("trust_ghost", 1), NoFlag("forced_archive"), NoFlag("told_root_ghost"), NoFlag("talked_eli")]), [Line("{dim}nobody is holding the line open.{/}")]),
                Pause(2600),
                Line(""),
                Line("{dim}the line will ring again in Act II: ARCHIVES.{/}"),
                Line("{dim}until then, DEADLINE stays up. it always does.{/}"),
                Pause(3500),
            ],
            on_end: [Set("act1_complete"), Print("{dim}...{/}"), Print("{amber}CARRIER RESTORED.{/} {dim}the board is quieter now.{/}")],
        ),
    ],
)
