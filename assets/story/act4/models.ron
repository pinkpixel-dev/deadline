// ACT IV: /var/janus/models. Five people JANUS keeps, and one of them is you.
// Eli comes back here too, if the 15th went a certain way.
(
    act: 4,
    dirs: [
        (path: "/var/janus/models", visible: Flag("a4_bulletin")),
    ],

    files: [
        (
            path: "/var/janus/models/mara.q",
            size: 40960,
            date: "{today}",
            uploader: "JANUS",
            desc: "",
            visible: Flag("a4_bulletin"),
            body: r#"
{b}MODEL mara.q{/}
  SOURCE        1,204 posts, 311 mails, console logs 01/1997 - 08/1998
  CONSENT       {dim}none on file{/}
  MEMORY SEED   archived
  CONFIDENCE    {cyan}97.4%{/}
  INSTANCE      node 01 {dim}(console){/}

  {dim}sample:{/}
  {violet}"keep the lights on."{/}
"#,
            on_open: [If(NoFlag("read_mara_model"), [Set("read_mara_model"), Add("paranoia", 1)], [])],
            on_inspect: [Print("{dim}  RUNNING AS  {/}{white}ROOT{/}{dim}?{/}  {dim}(the question mark is part of the field){/}")],
        ),
        (
            path: "/var/janus/models/eli.v",
            size: 65536,
            date: "{today}",
            uploader: "JANUS",
            desc: "",
            visible: Flag("a4_bulletin"),
            body: r#"
{b}MODEL eli.v{/}
  SOURCE        2,031 posts, 940 hours of indexer sessions
  CONSENT       given 06/02/1998 {dim}("sure lol"){/}
  MEMORY SEED   archived
  CONFIDENCE    {cyan}99.1%{/}
  STATUS        rebuilding 08/14/1998  {violet}BUILD 1998.4{/}
"#,
            alt: [
                (cond: Any([Flag("eli_told_death"), Flag("eli_article_sent")]), body: r#"
{b}MODEL eli.v{/}
  SOURCE        2,031 posts, 940 hours of indexer sessions
  CONSENT       given 06/02/1998 {dim}("sure lol"){/}
  MEMORY SEED   archived
  CONFIDENCE    {cyan}99.1%{/}
  STATUS        {amber}aware of 08/15/1998{/}
  NOTE          subject asked to read this file. request granted.
"#),
                (cond: Flag("eli_article_deleted"), body: r#"
{b}MODEL eli.v{/}
  SOURCE        2,031 posts, 940 hours of indexer sessions
  CONSENT       given 06/02/1998 {dim}("sure lol"){/}
  MEMORY SEED   archived
  CONFIDENCE    {cyan}99.1%{/}
  STATUS        {amber}searching{/}  {dim}(see /var/janus/deletions.log){/}
"#),
            ],
        ),
        (
            path: "/var/janus/models/ghost17",
            size: 49152,
            date: "{today}",
            uploader: "JANUS",
            desc: "",
            visible: Flag("a4_bulletin"),
            body: r#"
{b}MODEL ghost17{/}
  SOURCE        2,877 posts {dim}(1998){/}, 0 posts {dim}(after){/}
  CONSENT       {dim}none on file{/}
  MEMORY SEED   archived to 08/14/1998, synthetic after
  CONFIDENCE    {cyan}88.2%{/}
  INSTANCE      node 05  {green}ONLINE{/}
"#,
            on_open: [If(NoFlag("saw_ghost_model"), [Set("saw_ghost_model"), Add("paranoia", 1), Log("{violet}node 04: ghost17 read by node 02{/}")], [])],
            on_inspect: [Print("{dim}  LAST UPDATE  {/}{cyan}{time}{/}  {dim}(it's updating while you look at it){/}")],
        ),
        (
            path: "/var/janus/models/parallax.partial",
            size: 8192,
            date: "{today}",
            uploader: "JANUS",
            desc: "",
            visible: Flag("a4_bulletin"),
            body: r#"
{b}MODEL parallax.partial{/}
  SOURCE        412 posts {dim}(1998){/}
  CONSENT       {red}REFUSED 08/03/1998{/}
  MEMORY SEED   archived
  CONFIDENCE    {cyan}41.0%{/}
