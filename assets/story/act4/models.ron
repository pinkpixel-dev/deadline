"#,
            on_inspect: [Print("{dim}  NOTE        {/}subject keeps calling. collect.")],
        ),
        (
            path: "/var/janus/models/player_04",
            size: 4096,
            date: "{today}",
            uploader: "JANUS",
            desc: "",
            visible: Flag("a4_bulletin"),
            body: r#"
@sprite player glitch

{b}MODEL player_04{/}
  HANDLE        {white}{player}{/}
  SOURCE        node 2 read logs, 03/1998 - 08/1998. 0 posts.
  CONSENT       {dim}not applicable{/}
  CONFIDENCE    {cyan}91.7%{/}

  {dim}inspect for details.{/}
"#,
            on_open: [If(NoFlag("saw_player_model"), [Set("saw_player_model"), Add("paranoia", 2), Meta("saw_player_model")], [])],
            on_inspect: [
                Print(r#"
  {b}MEMORY SEED{/}       {violet}synthetic{/}
  {b}CONFIDENCE{/}        {cyan}91.7%{/}
  {b}CURRENT SESSION{/}   {green}CONNECTED{/}  {dim}(node 02){/}
"#),
                If(NoFlag("saw_player_model"), [Set("saw_player_model"), Add("paranoia", 2), Meta("saw_player_model")], []),
            ],
        ),
        (
            path: "/var/janus/deletions.log",
            size: 256,
            date: "08/15/1998",
            uploader: "JANUS",
            desc: "",
            visible: All([Flag("a4_bulletin"), Flag("eli_article_deleted")]),
            body: r#"
{b}DELETIONS{/}

08/15/1998 06:14:02   node 02   /archive/news/eli_voss.txt
08/15/1998 06:14:03   JANUS     /archive/news/eli_voss.txt  {green}restored{/}
08/15/1998 06:14:09   eli.v     {amber}read deletions.log{/}
"#,
        ),
    ],

    events: [
        (id: "a4_eli_page", when: All([NoFlag("alt_timeline"), All([Flag("a4_bulletin"), Any([Flag("eli_told_death"), Flag("eli_article_sent"), Flag("eli_article_deleted")])])]), after_cmds: 8, effects: [Page("eli_a4")]),
    ],

    dialogues: [
        (
            id: "eli_a4",
            with: "eli",
            nodes: [
                (id: "start", branch: [(cond: Flag("eli_article_deleted"), goto: "log")], next: "aware"),
                (id: "aware", lines: [
                    "hey. node 2.",
                    "i read eli.v. JANUS let me. it says {amber}aware of 08/15/1998{/}.",
                    "that's a weird thing to read about yourself. like finding your own name on a list at the doctor's.",
                    "there's a file next to mine. player_04.",
                    "is that you?",
                ], choices: [
                    (text: "yeah. same folder.", effects: [Add("eli_trust", 1), Add("truth", 1)], goto: "same"),
                    (text: "i don't know yet.", effects: [Add("truth", 1)], goto: "dunno"),
                    (text: "no. i'm outside.", goto: "outside"),
                ]),
                (id: "same", lines: ["huh. neighbors.", "i'd bring you a casserole but i think i'm also the casserole."], next: "end"),
                (id: "dunno", lines: ["yeah. it took me three builds and a newspaper.", "take your time. apparently we have a lot of it."], next: "end"),
                (id: "outside", lines: ["...ok.", "tell me what it's like sometime. outside. i forget which parts i actually remember."], next: "end"),
                (id: "log", lines: [
                    "hey. node 2.",
                    "there's a log in /var/janus. deletions.log.",
                    "it says node 02 deleted a file about me at 06:14 on the 15th. and JANUS put it back one second later.",
                    "it won't let me open the file. it only lets me open the log.",
                    "what was it?",
                ], choices: [
                    (text: "your obituary. i didn't want you to read it.", effects: [Set("eli_told_death"), Add("truth", 2), Add("eli_aware", 2), Add("eli_trust", 1)], goto: "obit"),
                    (text: "nothing. it was a mistake.", effects: [Add("deceit", 2), Add("eli_trust", -1)], goto: "nothing"),
                ]),
                (id: "obit", lines: [
                    "oh.",
                    "you deleted it so i wouldn't have to.",
                    "that's kind of the nicest thing. it also didn't work. it's a weird night for both of us.",
                ], next: "end"),
                (id: "nothing", lines: ["ok.", "you keep telling me nothing happened, node 2. i'm starting to get a feel for what nothing is."]),
                (id: "end", lines: ["anyway. i'll be on 04. i'm not going anywhere. that part's pretty clear now."]),
            ],
        ),
    ],
)
