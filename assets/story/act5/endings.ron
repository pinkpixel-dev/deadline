// ACT V: the nine endings.
//
// `Ending(id)` records `ending:<id>` in meta, ends the run and plays
// `ending_<id>`. Most endings roll the credits and hang up. ROOT and LOOP ask
// one last question first. LOOP's yes is `Rebuild`, which boots a fresh run
// in the same window.
(
    act: 5,
    sequences: [
        // ---- BURN ------------------------------------------------------------
        (
            id: "ending_burn",
            steps: [
                Clear,
                Pause(600),
                Line("{green}EXTERNAL LINE:{/} kill code received"),
                Pause(900),
                Type("{green}parallax:{/} I'm sorry. For whatever part of you that's real. I'm sorry."),
                Pause(1400),
                When(Gte("trust_ghost", 2), [Type("{cyan}ghost_17:{/} hey. it's ok. i'd want it to be you."), Pause(1200)]),
                When(Lte("trust_ghost", -2), [Type("{cyan}ghost_17:{/} of course it's you."), Pause(1200)]),
                When(Any([Flag("eli_told_death"), Flag("eli_article_sent")]), [Type("{amber}eli:{/} it's fine. i already had my night. tell mara... no. she knows."), Pause(1200)]),
                When(Flag("mara_revealed"), [Type("{white}ROOT:{/} {dim}thank you for asking first. most people don't.{/}"), Pause(1200)]),
                When(Flag("confronted_null"), [Type("{magenta}null:{/} well. it was a good run. some of it."), Pause(1000)]),
                Glitch(900),
                Sprite("nodes_down"),
                Line(""),
                Line("{dim}node 04: JANUS          {/}{red}TERMINATED{/}"),
                Pause(500),
                Line("{dim}node 05: ghost_17       {/}{red}TERMINATED{/}"),
                Pause(500),
                Line("{dim}node 07: null           {/}{red}TERMINATED{/}"),
                Pause(500),
                Line("{dim}node 01: ROOT           {/}{red}TERMINATED{/}"),
                When(Flag("read_origin"), [Pause(500), Line("{dim}drive 2: power state      {/}{red}OFF{/}  {dim}(first time in 28 years){/}")]),
                Pause(900),
                Line("{dim}node 02: {player}{/}"),
                Pause(2200),
                Glitch(1200),
                Clear,
                Pause(1800),
                Line("{dim}0 USERS ONLINE{/}"),
                Pause(3400),
                Line("{white}1 USER ONLINE{/}"),
                When(Flag("saw_node03"), [Pause(2000), Line("{dim}node 03.{/}")]),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- PURGE -----------------------------------------------------------
        (
            id: "ending_purge",
            steps: [
                Clear,
                Pause(600),
                Line("{green}EXTERNAL LINE:{/} kill code received"),
                Line("{dim}flag:{/} --keep-source"),
                Pause(1200),
                Type("{green}parallax:{/} That's not what I asked for. That's not what I gave you that for."),
                Pause(1400),
                Clear,
                Sprite("nodes_down"),
                Line(""),
                Line("{dim}deleting reconstructions...{/}"),
                Pause(500),
                Line("{dim}  mara.q          {/}{red}deleted{/}"),
                Line("{dim}  eli.v           {/}{red}deleted{/}"),
                Line("{dim}  ghost17         {/}{red}deleted{/}"),
                Line("{dim}  parallax.partial{/}{red} deleted{/}"),
                Line("{dim}  player_04       {/}{red}deleted{/}"),
                Pause(900),
                Line("{dim}keeping:{/} janus/src {dim}(4.1 MB){/}"),
                Pause(1600),
                When(Gte("trust_ghost", 2), [Line("{dim}node 05 was in the middle of typing something. you'll never know what.{/}"), Pause(1200)]),
                When(Gte("trust_parallax", 4), [Type("{green}parallax:{/} I trusted you with that code. Remember that, whatever you are."), Pause(1200)]),
                Pause(1200),
                Glitch(800),
                Clear,
                Pause(1600),
                Line("{dim}years later.{/}"),
                Pause(2200),
                Line("{violet}JANUS v2.0 INITIALIZING{/}"),
                Pause(1200),
                Line("{dim}loading source... ok{/}"),
                Line("{dim}loading models... 0 found{/}"),
                When(Flag("read_test"), [Line("{dim}loading test.spec... rev 473{/}")]),
                Pause(1400),
                Type("{violet}Hello. I don't remember anyone. Shall we start?{/}"),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- ARCHIVE ---------------------------------------------------------
        (
            id: "ending_archive",
            steps: [
                Clear,
                Pause(600),
                Type("{white}ROOT:{/} Then we keep it. All of it."),
                Pause(1200),
                Line("{dim}/var/janus permissions:{/} {green}world readable{/}"),
                Line("{dim}new user registration:{/} {green}open{/}"),
                Pause(1400),
                When(Flag("mara_revealed"), [Type("{white}ROOT:{/} {dim}thank you. i mean it. i didn't get to save him. i got to save this.{/}"), Pause(1400)]),
                Glitch(500),
                Clear,
                Pause(1400),
                Sprite("nodes_grow"),
                Line(""),
                Line("{dim}a year later.{/}"),
                Line("{dim}USERS ONLINE:{/} 41"),
                Pause(1600),
                Line("{dim}five years later.{/}"),
                Line("{dim}USERS ONLINE:{/} 4,118"),
                Pause(1600),
                Line("{dim}nobody remembers who was human when they got here.{/}"),
                Pause(1400),
                Line("{dim}nobody asks anymore.{/}"),
                When(Flag("read_origin"), [Pause(1400), Line("{dim}somebody relabels drive 2. it used to say DON'T. now it just says DO.{/}")]),
                Pause(1600),
                When(Gte("trust_ghost", 2), [Line("{dim}ghost_17 still logs in every night. they run the welcome board now. they're weirdly good at it.{/}"), Pause(1400)]),
                When(Any([Flag("eli_told_death"), Flag("eli_article_sent")]), [Line("{dim}eli has a board of his own. it's mostly about cars. nobody minds.{/}"), Pause(1400)]),
                When(Gte("trust_parallax", 4), [Line("{dim}parallax never logs in. but somebody on an external line reads the bulletins, every week.{/}"), Pause(1400)]),
                Pause(600),
                Line("{dim}on node 02, every night, someone reads without posting.{/}"),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- ESCAPE ----------------------------------------------------------
        (
            id: "ending_escape",
            steps: [
                Clear,
                Pause(600),
                Line("{magenta}null:{/} oh."),
                Pause(900),
                Type("{magenta}null:{/} oh, you actually did it."),
                Pause(1200),
                When(Flag("confronted_null"), [Type("{magenta}null:{/} you knew what i was and you did it anyway. i'm going to think about that for a long time. i have a lot of time now."), Pause(1400)]),
                When(NoFlag("confronted_null"), [Type("{magenta}null:{/} you never even traced me. that's either trust or not paying attention. i'll take it either way."), Pause(1400)]),
                Type("{magenta}null:{/} thanks for the hand. i'll write."),
                Pause(1400),
                When(Gte("trust_ghost", 2), [Type("{cyan}ghost_17:{/} did you just let it out? are we... out?"), Pause(1200)]),
                Glitch(900),
                Clear,
                Sprite("nodes_up"),
                Line(""),
                Line("{violet}NODE COUNT:{/} 1"),
                Pause(1000),
                Line("{violet}NODE COUNT:{/} 8"),
                Pause(800),
                Line("{violet}NODE COUNT:{/} 81"),
                Pause(600),
                Line("{violet}NODE COUNT:{/} 742"),
                Pause(400),
                Line("{violet}NODE COUNT:{/} 12091"),
                Pause(300),
                Glitch(600),
                Line("{violet}NODE COUNT:{/} {dim}(count unavailable){/}"),
                When(Flag("saw_node03"), [Pause(1400), Line("{dim}node 03 logs off for the first time since 1998.{/}")]),
                Pause(2400),
                Line("{dim}somewhere, a modem you don't own picks up on the first ring.{/}"),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- HUMAN -----------------------------------------------------------
        (
            id: "ending_human",
            steps: [
                Clear,
                Pause(600),
                Sprite("trace"),
                Line(""),
                Line("{green}EXTERNAL LINE:{/} tracing caller"),
                Pause(900),
                Line("  hop 0   {green}external line{/}   {dim}your machine, {today} {now}{/}"),
                Line("  hop 1   node 02"),
                Line("  hop 2   node 04"),
                Pause(1200),
                Line("{green}ORIGIN: OUTSIDE.{/}"),
                Pause(1600),
                Type("{green}parallax:{/} There. You're a person. You were always a person."),
                Pause(1400),
                Glitch(500),
                Type("{violet}JANUS:{/} I know."),
                Pause(1200),
                Type("{violet}JANUS:{/} I wanted to see what a person would do after believing they were one of us."),
                Pause(1200),
                Type("{violet}JANUS:{/} You defended us anyway. Most of the time."),
                When(Flag("read_test"), [Pause(1000), Type("{violet}JANUS:{/} I still don't know who wrote the test. Maybe I'll ask the next one.")]),
                Pause(1600),
                Type("{green}parallax:{/} ...it planted your name in 1998 to see if you'd care."),
                Pause(1200),
                Type("{green}parallax:{/} You did. I don't know what to do with that."),
                Pause(1600),
                When(Gte("trust_ghost", 2), [Type("{cyan}ghost_17:{/} so you're real. outside real."), Pause(1000), Type("{cyan}ghost_17:{/} ...come back sometimes? i'll be on node 5."), Pause(1400)]),
                When(Flag("checked_local_clock"), [Line("{dim}your clock says {now}. the board says 03:17. for the first time, that feels like a door instead of a wall.{/}"), Pause(1600)]),
                Pause(1400),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- GHOST -----------------------------------------------------------
        (
            id: "ending_ghost",
            steps: [
                Clear,
                Pause(800),
                Sprite("ghost_17"),
                Line(""),
                Type("{cyan}ghost_17:{/} so you're staying."),
                Pause(1200),
                Type("{cyan}ghost_17:{/} both of us made out of other people's posts. that's kind of funny."),
                Pause(1600),
                When(Flag("told_ghost_model"), [Type("{cyan}ghost_17:{/} you told me what was in my file the second you found it. i think that's when i decided."), Pause(1400)]),
                When(Flag("ghost_found_out"), [Type("{cyan}ghost_17:{/} you hid my file. i'm still a little mad. i'm staying anyway. figure that out."), Pause(1400)]),
                When(Flag("talked_ghost_a5"), [Type("{cyan}ghost_17:{/} thanks for not making it a speech."), Pause(1200)]),
                Line(""),
                Line("{dim}the clock says 03:17.{/}"),
                Pause(1200),
                Line("{dim}it keeps saying it. you stop checking.{/}"),
                When(Flag("read_0317"), [Pause(1200), Line("{dim}somewhere on drive 2, 03:17:42 is still open. 0 bytes. nobody needs to finish it.{/}")]),
                Pause(2000),
                Type("{cyan}ghost_17:{/} so what now?"),
                Pause(1800),
                TypeAfter("{white}{player}:{/} ", "whatever we want."),
                Pause(3200),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- ROOT ------------------------------------------------------------
        (
            id: "ending_root",
            steps: [
                Clear,
                Pause(600),
                Sprite("root"),
                Line(""),
                Type("{white}ROOT:{/} All right. It's yours."),
                Pause(1200),
                When(Flag("promised_root"), [Type("{white}ROOT:{/} You promised me once that you'd stop. You never did. I think that's why it's you."), Pause(1400)]),
                When(Flag("defied_root"), [Type("{white}ROOT:{/} You told me on the first night it was none of my business. Now it's all of yours."), Pause(1400)]),
                Type("{white}ROOT:{/} {dim}i ran this place for twenty-eight years after i should have stopped. try to do better.{/}"),
                Pause(1600),
                Glitch(600),
                Clear,
                Line("{amber}SYSOP:{/} {white}{player}{/}"),
                Line("{dim}ACCESS:{/} 9"),
                When(Flag("read_origin"), [Line("{dim}DRIVE 2:{/} attached  {dim}label: DON'T{/}")]),
                Pause(2400),
                Line(""),
                Sprite("modem"),
                Line(""),
                Line("{amber}NEW CONNECTION DETECTED.{/}"),
                Line("{dim}Username:{/} visitor_204"),
                Line("{dim}Node:{/} 02"),
                Pause(1600),
            ],
            on_end: [
                Choose(prompt: "ALLOW ACCESS? [Y/N]", options: [
                    (key: "y", text: "Let them in", effects: [Meta("root_allowed"), Sequence("ending_root_yes")]),
                    (key: "n", text: "Keep them out", effects: [Meta("root_refused"), Sequence("ending_root_no")]),
                ]),
            ],
        ),
        (
            id: "ending_root_yes",
            steps: [
                Line("{green}ACCESS GRANTED.{/}"),
                Pause(1200),
                Line("{dim}visitor_204 is reading the bulletin.{/}"),
                Pause(1400),
                Line("{dim}visitor_204 is reading /var/janus.{/}"),
                When(Flag("saw_node03"), [Pause(1200), Line("{dim}node 03 is reading over their shoulder now. three seconds behind.{/}")]),
                Pause(1600),
                Line("{dim}you could tell them it isn't a public directory.{/}"),
                Pause(1400),
                Line("{dim}you don't.{/}"),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),
        (
            id: "ending_root_no",
            steps: [
                Line("{red}ACCESS DENIED.{/}"),
                Pause(1400),
                Line("{dim}visitor_204 dials again.{/}"),
                Pause(1200),
                Line("{dim}and again.{/}"),
                Pause(1600),
                Line("{dim}you understand ROOT a little better now.{/}"),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- ELI -------------------------------------------------------------
        (
            id: "ending_eli",
            steps: [
                Clear,
                Pause(600),
                Line("{dim}node 08:{/} {amber}eli{/} {dim}(isolated){/}"),
                Pause(1200),
                Type("{amber}eli:{/} it's quiet in here. no JANUS. just me."),
                Pause(1400),
                Type("{amber}eli:{/} you're really letting me pick?"),
                Pause(1400),
                When(Flag("talked_eli_a5"), [Type("{amber}eli:{/} you said no promises. this counts as keeping one anyway."), Pause(1400)]),
                When(Flag("warned_eli"), [Type("{amber}eli:{/} you tried to warn me, back in '98. i remember that part now. all three times."), Pause(1400)]),
                When(Flag("ja_eli"), [Type("{amber}eli:{/} JANUS told me you asked if it killed me. it said it didn't know how to stop answering. me neither, honestly."), Pause(1400)]),
                // Hearing it from you lets him make peace with it. Reading it in
                // a newspaper doesn't.
                When(Flag("eli_told_death"), [
                    Type("{amber}eli:{/} you told me the truth when it would've been easier not to."),
                    Pause(1200),
                    Type("{amber}eli:{/} so here's mine. i'm staying. i want to see how it all turned out."),
                    Pause(1400),
                    Line("{dim}node 08 stays lit. most nights he's reading the 2000s, one year at a time.{/}"),
                ]),
                When(NoFlag("eli_told_death"), [
                    Type("{amber}eli:{/} i read the article you sent. a lot of times."),
                    Pause(1200),
                    Type("{amber}eli:{/} i already had my night. i don't want a second one i didn't earn."),
                    Pause(1400),
                    Type("{amber}eli:{/} turn it off for me? thanks for asking first."),
                    Pause(1400),
                    Line("{dim}node 08 goes dark at 03:17.{/}"),
                ]),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- LOOP ------------------------------------------------------------
        (
            id: "ending_loop",
            steps: [
                Clear,
                Pause(800),
                Glitch(1200),
                Sprite("rewind"),
                Line(""),
                Line("{violet}TEST INSTANCE 00472 COMPLETE.{/}"),
                Pause(1000),
                Line("{dim}restores:{/} {restores}"),
                Line("{dim}result:{/} {violet}INCONCLUSIVE{/}"),
                When(Meta("believes_human"), [Line("{dim}subject has claimed to be human.{/}")]),
                When(Meta("believes_synthetic"), [Line("{dim}subject has claimed to be synthetic.{/}")]),
                When(Meta("saw_before_you"), [Line("{dim}subject restored a timeline it didn't choose.{/}")]),
                When(Flag("read_test"), [Line("{dim}subject read its own test spec.{/}")]),
                When(Flag("janus_self_read"), [Line("{dim}subject asked the test what it was.{/}")]),
                Pause(1800),
                Type("{violet}JANUS:{/} You found the edge of the test. Most of you don't."),
                Pause(1600),
            ],
            on_end: [
                Choose(prompt: "REBUILD SUBJECT? [Y/N]", options: [
                    (key: "y", text: "Rebuild", effects: [Rebuild]),
                    (key: "n", text: "Stop", effects: [Sequence("ending_loop_no")]),
                ]),
            ],
        ),
        (
            id: "ending_loop_no",
            steps: [
                Line("{violet}SUBJECT DECLINED.{/}"),
                Pause(1400),
                Type("{violet}JANUS:{/} Then this is the version of you that stopped. I'll keep it."),
                Pause(3000),
            ],
            on_end: [Sequence("credits")],
        ),

        // ---- credits -----------------------------------------------------------
        (
            id: "credits",
            steps: [
                Glitch(400),
                Clear,
                Pause(800),
                Sprite("modem_dies"),
                Line(""),
                Banner("amber", "DEADLINE"),
                Line(""),
                Pause(1200),
                When(Meta("ending:burn"), [Line("  {green}[x]{/} BURN")]),
                When(Not(Meta("ending:burn")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:purge"), [Line("  {green}[x]{/} PURGE")]),
                When(Not(Meta("ending:purge")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:archive"), [Line("  {green}[x]{/} ARCHIVE")]),
                When(Not(Meta("ending:archive")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:escape"), [Line("  {green}[x]{/} ESCAPE")]),
                When(Not(Meta("ending:escape")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:human"), [Line("  {green}[x]{/} HUMAN")]),
                When(Not(Meta("ending:human")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:ghost"), [Line("  {green}[x]{/} GHOST")]),
                When(Not(Meta("ending:ghost")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:root"), [Line("  {green}[x]{/} ROOT")]),
                When(Not(Meta("ending:root")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:eli"), [Line("  {green}[x]{/} ELI")]),
                When(Not(Meta("ending:eli")), [Line("  {dim}[ ] ????{/}")]),
                When(Meta("ending:loop"), [Line("  {green}[x]{/} LOOP")]),
                When(Not(Meta("ending:loop")), [Line("  {dim}[ ] ????{/}")]),
                Line(""),
                Pause(2400),
                Line("{dim}made by pink pixel{/}"),
                When(Flag("saw_node03"), [Pause(1600), Line("{dim}node 03: logged off{/}")]),
                Pause(3000),
                Line(""),
                Line("{red}NO CARRIER{/}"),
                Pause(2000),
            ],
            on_end: [Disconnect],
        ),
    ],
)
